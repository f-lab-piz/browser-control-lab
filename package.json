{
  "name": "browser-control-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "site": "node test-site/server.mjs",
    "test": "node --test tests/contracts.test.mjs tests/bridge.test.mjs",
    "test:fixtures": "node --test tests/fixture-ui.test.mjs",
    "test:bootstrap": "node --test tests/extension-bootstrap.test.mjs",
    "test:all": "npm test && npm run test:fixtures && npm run test:bootstrap && npm run test:runtime",
    "bridge": "node bridge/cli.mjs",
    "test:runtime": "node --test tests/runtime-e2e.test.mjs",
    "test:audit": "node scripts/audit-tools.mjs",
    "test:audit-fixture": "node --test tests/audit-fixture.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "acorn": "^8.19.0",
    "astring": "^1.9.0",
    "quickjs-emscripten-core": "^0.32.0"
  }
}
